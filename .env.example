FLASK_ENV=production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Generated via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

