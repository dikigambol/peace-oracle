DAILY_AI_LIMIT=10
FINGERPRINT_AI_LIMIT=30
DAILY_AI_BUDGET=300
TAROT_AI_LIMIT=10
TAROT_FINGERPRINT_AI_LIMIT=30
TAROT_AI_BUDGET=300
DB_OFFLINE_COOLDOWN=60
MEMORY_STORE_MAX=5000

